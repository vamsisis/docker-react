    {
      "id": 15,
      "title": "Restarts per Container",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 49
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count by (container_name) (count by (container_name, container_id) (last_over_time(container_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}[$__range]))) - 1",
          "legendFormat": "{{container_name}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Restart count per container over the selected time range, written out in plain English so nobody has to remember what a bare number means.\n\nHow it works: ECS assigns a NEW container_id every time a container starts. Counting distinct container_ids and subtracting 1 (the original start) gives the number of restarts. There is no native restart metric in this receiver, so ID churn is the signal.\n\ngreen = none, orange = 1-2, red = 3+, and 6 or more reads as RESTART LOOP.\n\nScoped to the time picker: at 'Last 30 minutes' you only see restarts within those 30 minutes. Widen the range to catch older ones.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "minWidth": 80,
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "container"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "restarts"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 175
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No restarts",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "1 restart",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "2 restarts",
                        "color": "orange",
                        "index": 2
                      },
                      "3": {
                        "text": "3 restarts",
                        "color": "red",
                        "index": 3
                      },
                      "4": {
                        "text": "4 restarts",
                        "color": "red",
                        "index": 4
                      },
                      "5": {
                        "text": "5 restarts",
                        "color": "red",
                        "index": 5
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 6,
                      "to": 9999,
                      "result": {
                        "text": "6+ restarts - looping",
                        "color": "red",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "restarts",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(container_name|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "container_name": "container",
              "Value": "restarts"
            }
          }
        }
      ]
    },
    {
      "id": 115,
      "title": "Container Status, Image & Exit Codes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 49
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "group by (container_name, container_image_name, container_image_tag, aws_ecs_container_know_status, aws_ecs_container_exit_code, aws_ecs_container_started_at, aws_ecs_container_finished_at) (last_over_time(container_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Shows EVERY container seen in the selected time range, including ones that have since stopped.\n\nTwo things make that work: 'group by' forces one uniform label set so running containers (no exit_code / finished_at) and stopped ones render in the same table; 'last_over_time(...[$__range])' looks back across the whole window so a container that stopped emitting is still found. A plain instant query evaluates at 'now' and drops stopped containers entirely.\n\nThis panel intentionally IGNORES the Container variable - a stopped container often is not in that dropdown's current value list, so filtering by it would hide exactly what you want to see. Use the column filter in the table header to narrow instead.\n\nWiden the time picker to see further back: at 'Last 30 minutes' you only see containers active in the last 30 minutes.\n\nTimestamps: the receiver emits started_at / finished_at as ISO strings in UTC. A convertFieldType transform turns them into real time fields so Grafana can localise them; the dashboard timezone is set to America/Chicago, so they render in Central and follow the CST/CDT switch automatically. Change it under Dashboard settings > General > Timezone if your team is elsewhere.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "container"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "image"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 280
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tag"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "green",
                        "index": 0
                      },
                      "STOPPED": {
                        "color": "red",
                        "index": 1
                      },
                      "PENDING": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "exit code"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "color": "green",
                        "text": "0 clean",
                        "index": 0
                      },
                      "137": {
                        "color": "red",
                        "text": "137 OOM",
                        "index": 1
                      },
                      "139": {
                        "color": "red",
                        "text": "139 segv",
                        "index": 2
                      },
                      "143": {
                        "color": "orange",
                        "text": "143 term",
                        "index": 3
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "\u2014",
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(started|finished)$/"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 185
              },
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "\u2014",
                        "color": "text",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "status",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(container_name|container_image_name|container_image_tag|aws_ecs_container_know_status|aws_ecs_container_exit_code|aws_ecs_container_started_at|aws_ecs_container_finished_at)$"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "fields": {},
            "conversions": [
              {
                "targetField": "aws_ecs_container_started_at",
                "destinationType": "time"
              },
              {
                "targetField": "aws_ecs_container_finished_at",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "container_name": 0,
              "container_image_name": 1,
              "container_image_tag": 2,
              "aws_ecs_container_know_status": 3,
              "aws_ecs_container_exit_code": 4,
              "aws_ecs_container_started_at": 5,
              "aws_ecs_container_finished_at": 6
            },
            "renameByName": {
              "container_name": "container",
              "container_image_name": "image",
              "container_image_tag": "tag",
              "aws_ecs_container_know_status": "status",
              "aws_ecs_container_exit_code": "exit code",
              "aws_ecs_container_started_at": "started",
              "aws_ecs_container_finished_at": "finished"
            }
          }
        }
      ]
    },
