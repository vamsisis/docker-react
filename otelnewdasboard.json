    {
      "id": 115,
      "title": "Container Image & Lifecycle",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 41
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "group by (container_name, container_image_name, container_image_tag, aws_ecs_container_know_status, aws_ecs_container_exit_code, aws_ecs_container_started_at, aws_ecs_container_finished_at) (container_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Uses 'group by' in PromQL rather than a raw selector. That forces every series to carry the SAME label set - a label a container lacks comes back empty instead of the field being absent. Previously running containers (no exit_code / finished_at) and stopped ones had different schemas, merge could not reconcile them, and only the stopped container rendered. Label names confirmed from Explore: container_image_name, container_image_tag, aws_ecs_container_know_status (yes, 'know' not 'known'). Sorted so STOPPED sorts above RUNNING.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true,
            "minWidth": 80
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "container"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "image"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 280
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tag"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8AB8FF"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "green",
                        "index": 0
                      },
                      "STOPPED": {
                        "color": "red",
                        "index": 1
                      },
                      "PENDING": {
                        "color": "yellow",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "exit code"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "color": "green",
                        "text": "0 clean",
                        "index": 0
                      },
                      "137": {
                        "color": "red",
                        "text": "137 OOM",
                        "index": 1
                      },
                      "139": {
                        "color": "red",
                        "text": "139 segv",
                        "index": 2
                      },
                      "143": {
                        "color": "orange",
                        "text": "143 term",
                        "index": 3
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "\u2014",
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(started|finished)$/"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "\u2014",
                        "color": "text",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "status",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(container_name|container_image_name|container_image_tag|aws_ecs_container_know_status|aws_ecs_container_exit_code|aws_ecs_container_started_at|aws_ecs_container_finished_at)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "container_name": 0,
              "container_image_name": 1,
              "container_image_tag": 2,
              "aws_ecs_container_know_status": 3,
              "aws_ecs_container_exit_code": 4,
              "aws_ecs_container_started_at": 5,
              "aws_ecs_container_finished_at": 6
            },
            "renameByName": {
              "container_name": "container",
              "container_image_name": "image",
              "container_image_tag": "tag",
              "aws_ecs_container_know_status": "status",
              "aws_ecs_container_exit_code": "exit code",
              "aws_ecs_container_started_at": "started",
              "aws_ecs_container_finished_at": "finished"
            }
          }
        }
      ]
    },
