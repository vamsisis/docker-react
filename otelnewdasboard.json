{
  "id": null,
  "uid": "ecs-otel-fargate",
  "title": "ECS Fargate - Task & Container Resource Usage",
  "tags": [
    "ecs",
    "fargate",
    "otel",
    "prometheus"
  ],
  "timezone": "America/Chicago",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus / AMP datasource"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(aws_ecs_cluster_name)",
          "refId": "cluster"
        },
        "multi": false,
        "includeAll": false,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Cluster",
        "description": "Robust form used by your existing working dashboards - not tied to any single metric, so it can't break if one metric has a gap."
      },
      {
        "name": "task_family",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({aws_ecs_cluster_name=\"$cluster\"}, aws_ecs_task_family)",
          "refId": "task_family"
        },
        "multi": false,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Task Family",
        "description": "Stable across redeploys, unlike task_id - lets you find 'the service' before picking a specific running instance of it."
      },
      {
        "name": "task_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({aws_ecs_cluster_name=\"$cluster\", aws_ecs_task_family=\"$task_family\"}, aws_ecs_task_id)",
          "refId": "task_id"
        },
        "multi": false,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Task ID",
        "description": "Set to a single task_id (not 'All') to isolate one running task's metrics end-to-end across every panel."
      },
      {
        "name": "container_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({aws_ecs_cluster_name=\"$cluster\", aws_ecs_task_id=\"$task_id\"}, container_name)",
          "refId": "container_name"
        },
        "multi": true,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Container"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Task Health & Capacity  \u2014  whole task (all containers combined)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "CPU Used vs Allocated (%)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(rate(ecs_task_cpu_usage_total_Nanoseconds{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}[5m]) / (ecs_task_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} * 1e9)) * 100",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Mirrors alert ecs_cpu_alerts / TaskCPUUsageAbove{80,85} VERBATIM - same expression the rule evaluates, so whatever number pages you is the number on this panel.\n\nNote the values are very small (~0.008 for a task at 8% CPU). That is because the rule divides by ecs_task_cpu_reserved_None * 1e9, and reserved_None is in CPU UNITS (1024 = 1 vCPU) rather than cores. This panel is deliberately NOT corrected - it exists to match the alert. Use 'CPU: Actual vs Allocated' and 'Spare CPU' beside it for the true operational picture.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false,
            "minWidth": 90
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "decimals": 5
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "task"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient",
                  "applyToRowBg": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "CPU %",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(aws_ecs_task_id|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "aws_ecs_task_id": "task",
              "Value": "CPU %"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "CPU %",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU: Actual vs Allocated",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ecs_task_cpu_usage_vcpu_vCPU{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "used - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "ecs_task_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} / 1024",
          "legendFormat": "reserved - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Both series in vCPU - same unit as the task definition. Reserved / 1024 converts CPU units to vCPU. Axis reads 0.5 / 1 / 2 vCPU instead of 1.0K / 2.0K / 4.0K.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": "vCPU",
            "axisSoftMin": 0
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^reserved.*/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^used.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Spare CPU (unused, allocated but idle)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(ecs_task_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} / 1024) - ecs_task_cpu_usage_vcpu_vCPU{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "{{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Reserved minus used, in vCPU - what rightsizing the task definition would reclaim.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": "vCPU"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1024
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Memory: Actual vs Allocated",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ecs_task_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "used - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "ecs_task_memory_reserved_Megabytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} * 1024 * 1024",
          "legendFormat": "reserved - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Mirrors your working 'Memory Allocation vs Usage' panel - used in Bytes vs reserved converted from Megabytes. Reserved is drawn as an orange dashed line, used as solid green with light fill, so the gap between them reads as headroom at a glance.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^reserved.*/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^used.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Memory Used vs Allocated (%)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(ecs_task_memory_utilized_Megabytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} / ecs_task_memory_reserved_Megabytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}) * 100",
          "legendFormat": "{{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "MATCHES alert ecs_memory_alerts / TaskMemoryUsageAbove{75,80,85} exactly: memory_utilized_Megabytes / memory_reserved_Megabytes.\n\nPreviously this used memory_usage_Bytes / memory_usage_limit_Bytes. That reads HIGHER because usage includes page cache while utilized does not - so an alert could fire at 80% utilized while this panel showed a very different number and the on-call engineer would dismiss it as false.\n\nThresholds: yellow 75 (Warning/15m), orange 80 (High/5m), red 85 (critical/5m).",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Network In / Out",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ecs_task_network_rate_rx_Bytes_per_Second{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "rx - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "ecs_task_network_rate_tx_Bytes_per_Second{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "tx - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Receiver pre-computes rate - do NOT wrap in rate()/irate(), that metric is already a rate.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Disk Read / Write",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "irate(ecs_task_storage_read_bytes_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}[5m])",
          "legendFormat": "read - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "irate(ecs_task_storage_write_bytes_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}[5m])",
          "legendFormat": "write - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "These ARE cumulative counters (no _per_Second suffix) - irate() is required here, unlike the network metrics above.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Container Breakdown  \u2014  which container inside the task is using what",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "CPU per Container (% of task allocation)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "(rate(container_cpu_usage_total_Nanoseconds{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}[5m]) / (container_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"} * 1e9)) * 100",
          "legendFormat": "{{container_name}} - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Mirrors alerts ContainerCPUUsageAbove75 and the rule at line 105 VERBATIM, so the panel shows exactly what the alert evaluates.\n\nSame note as the task panel: values are ~1024x smaller than true utilisation because reserved_None is in CPU units, not cores. Left uncorrected on purpose so alert and panel agree.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 5,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": ""
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "CPU per Container (vCPU)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "container_cpu_usage_vcpu_vCPU{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}",
          "legendFormat": "{{container_name}} - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "vCPU, consistent with the task-level panels.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": "vCPU"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Memory per Container (GiB)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "container_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}",
          "legendFormat": "used - {{container_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "container_memory_reserved_Megabytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"} * 1024 * 1024",
          "legendFormat": "reserved - {{container_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "If the 'reserved' series is empty, that container has no memory reservation set in its container definition - expected unless you set hard/soft limits per container. Reserved is drawn as an orange dashed line, used as solid green with light fill, so the gap between them reads as headroom at a glance.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^reserved.*/"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^used.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              }
            ]
          }
        ]
      },
      "options": {}
    },
