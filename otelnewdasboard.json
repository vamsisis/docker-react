{
  "id": null,
  "uid": null,
  "title": "ECS Fargate + OTel Sidecar - Container & Task Metrics",
  "tags": [
    "ecs",
    "fargate",
    "otel",
    "prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Prometheus / AMP datasource"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(aws_ecs_cluster_name)",
          "refId": "cluster"
        },
        "multi": false,
        "includeAll": false,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Cluster",
        "description": "Robust form used by your existing working dashboards - not tied to any single metric, so it can't break if one metric has a gap."
      },
      {
        "name": "task_family",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({aws_ecs_cluster_name=\"$cluster\"}, aws_ecs_task_family)",
          "refId": "task_family"
        },
        "multi": false,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Task Family",
        "description": "Stable across redeploys, unlike task_id - lets you find 'the service' before picking a specific running instance of it."
      },
      {
        "name": "task_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({aws_ecs_cluster_name=\"$cluster\", aws_ecs_task_family=\"$task_family\"}, aws_ecs_task_id)",
          "refId": "task_id"
        },
        "multi": false,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Task ID",
        "description": "Set to a single task_id (not 'All') to isolate one running task's metrics end-to-end across every panel."
      },
      {
        "name": "container_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values({aws_ecs_cluster_name=\"$cluster\", aws_ecs_task_id=\"$task_id\"}, container_name)",
          "refId": "container_name"
        },
        "multi": true,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "label": "Container"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Task Overview  (ecs_task_* - one series per running task)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Task CPU Utilization (% of reserved)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * ecs_task_cpu_utilized_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} / ecs_task_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "100 * utilized / reserved. Colour steps: green <40, lime 40, yellow 60, orange 75, red 90. Sub-1% readings mean the task is heavily over-provisioned.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "custom": {
            "cellOptions": {
              "type": "color-text"
            },
            "align": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#7FB800",
                "value": 40
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(aws_ecs_task_id|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "aws_ecs_task_id": "task",
              "Value": "CPU %"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "CPU %",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Task CPU: Used vs Reserved (CPU units, log scale)",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 1
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ecs_task_cpu_usage_vcpu_vCPU{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} * 1024",
          "legendFormat": "used - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "ecs_task_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "reserved - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Both series in CPU units (1024 = 1 vCPU) so they share an axis. LOG scale is essential here: used is single-digit units against 1024-4096 reserved, which on a linear axis flatlines at zero. The vertical gap between the two lines IS your headroom.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "reserved.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Task CPU Headroom (unused CPU units)",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ecs_task_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} - (ecs_task_cpu_usage_vcpu_vCPU{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} * 1024)",
          "legendFormat": "{{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Reserved minus used, in CPU units. This is what you'd reclaim by rightsizing. A line sitting near the reservation ceiling means almost nothing is being used.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": ""
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1024
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Task Memory: Used vs Reserved",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ecs_task_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "used - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "ecs_task_memory_reserved_Megabytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} * 1024 * 1024",
          "legendFormat": "reserved - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Mirrors your working 'Memory Allocation vs Usage' panel - used in Bytes vs reserved converted from Megabytes.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Task Memory Utilization (%)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * ecs_task_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"} / ecs_task_memory_usage_limit_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "{{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Derived: usage_Bytes / usage_limit_Bytes * 100.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Task Network Throughput",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ecs_task_network_rate_rx_Bytes_per_Second{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "rx - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "ecs_task_network_rate_tx_Bytes_per_Second{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "tx - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Receiver pre-computes rate - do NOT wrap in rate()/irate(), that metric is already a rate.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Task Storage I/O (rate)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "irate(ecs_task_storage_read_bytes_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}[5m])",
          "legendFormat": "read - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "irate(ecs_task_storage_write_bytes_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}[5m])",
          "legendFormat": "write - {{aws_ecs_task_id}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "These ARE cumulative counters (no _per_Second suffix) - irate() is required here, unlike the network metrics above.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Container Detail  (container_* - one series per container within selected task(s))",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Container CPU Utilization (% of task reserved)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * container_cpu_utilized_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"} / on(aws_ecs_task_id) group_left ecs_task_cpu_reserved_None{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\"}",
          "legendFormat": "{{container_name}} - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "container_cpu_utilized_None is also in CPU units, not percent. Divided here by the parent task's reserved units to get a real percentage. If this returns nothing, the join label may differ - fall back to the raw container_cpu_usage_vcpu_vCPU panel beside it.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": ""
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Container CPU Usage (mCPU)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "container_cpu_usage_vcpu_vCPU{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"} * 1000",
          "legendFormat": "{{container_name}} - {{aws_ecs_task_id}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Millicores (vCPU x 1000) - same convention Kubernetes uses. 6.8 mCPU reads far better than 0.0068 vCPU on a Y axis.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1.4,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Container Memory Usage by container",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "container_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}",
          "legendFormat": "used - {{container_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "container_memory_reserved_Megabytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"} * 1024 * 1024",
          "legendFormat": "reserved - {{container_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "If the 'reserved' series is empty, that container has no memory reservation set in its container definition - expected unless you set hard/soft limits per container.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Container Network Throughput by container",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "container_network_rate_rx_Bytes_per_Second{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}",
          "legendFormat": "rx - {{container_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "container_network_rate_tx_Bytes_per_Second{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}",
          "legendFormat": "tx - {{container_name}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Container Instances in Selected Range",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 41
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "count by (container_name) (count by (container_name, container_id) (last_over_time(container_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}[$__range])))",
          "legendFormat": "{{container_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "Distinct container_id values seen for each container over the dashboard's selected time range (uses $__range, so it follows the time picker instead of a hardcoded window). 1 = no restart. A value of N means N-1 restarts happened, because every restart gets a fresh container_id in ECS/Docker.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(container_name|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "container_name": "container",
              "Value": "instances"
            }
          }
        }
      ]
    },
    {
      "id": 115,
      "title": "Container Lifecycle & Exit Codes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 41
      },
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "last_over_time(container_memory_usage_Bytes{aws_ecs_cluster_name=~\"$cluster\", aws_ecs_task_id=~\"$task_id\", container_name=~\"$container_name\"}[$__range])",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "description": "Five columns only. exit code / finished stay blank while status = RUNNING - that is correct, they populate only after a container stops. 137 = OOM-killed, 0 = clean, other = crash.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "exit code"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "color": "green",
                        "index": 0
                      },
                      "137": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(container_name|aws_ecs_container_known_status|aws_ecs_container_exit_code|aws_ecs_container_started_at|aws_ecs_container_finished_at)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "container_name": 0,
              "aws_ecs_container_known_status": 1,
              "aws_ecs_container_exit_code": 2,
              "aws_ecs_container_started_at": 3,
              "aws_ecs_container_finished_at": 4
            },
            "renameByName": {
              "container_name": "container",
              "aws_ecs_container_known_status": "status",
              "aws_ecs_container_exit_code": "exit code",
              "aws_ecs_container_started_at": "started",
              "aws_ecs_container_finished_at": "finished"
            }
          }
        }
      ]
    },
