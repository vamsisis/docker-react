{
  "__inputs": [
    {
      "name": "DS_CLOUDWATCH",
      "label": "CloudWatch",
      "description": "AWS CloudWatch datasource",
      "type": "datasource",
      "pluginId": "cloudwatch",
      "pluginName": "CloudWatch"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "cloudwatch", "name": "CloudWatch", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "row", "name": "Row", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "ELB / ALB prod ops dashboard. CloudWatch datasource. ELB+TG focused — Fleet Health, Connection Errors, 5xx split, Latency percentiles.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Health Overview",
      "type": "row"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "description": "% of targets healthy. Red <80% = immediate action needed.",
      "title": "Fleet Health %",
      "type": "stat",
      "targets": [
        {
          "alias": "", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "hide": true, "id": "m1", "matchExact": true, "metricEditorMode": 0,
          "metricName": "HealthyHostCount", "metricQueryType": 0,
          "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "A", "region": "${region}", "statistic": "Maximum"
        },
        {
          "alias": "", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "hide": true, "id": "m2", "matchExact": true, "metricEditorMode": 0,
          "metricName": "UnHealthyHostCount", "metricQueryType": 0,
          "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "B", "region": "${region}", "statistic": "Maximum"
        },
        {
          "alias": "Fleet Health %", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": {}, "expression": "IF(FILL(m1,0)+FILL(m2,0)>0,FILL(m1,0)/(FILL(m1,0)+FILL(m2,0))*100,100)",
          "hide": false, "id": "e1", "matchExact": true, "metricEditorMode": 1,
          "metricName": "", "metricQueryType": 1, "namespace": "",
          "period": "60", "refId": "C", "region": "${region}", "statistic": "Maximum"
        }
      ]
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "options": { "0": { "color": "green", "index": 0, "text": "0 ✅" } }, "type": "value" }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Unhealthy Hosts",
      "type": "stat",
      "targets": [
        {
          "alias": "Unhealthy Hosts", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "UnHealthyHostCount",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "A", "region": "${region}", "statistic": "Maximum"
        }
      ]
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "options": { "0": { "color": "green", "index": 0, "text": "0 ✅" } }, "type": "value" }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "description": "ELB failed to open TCP connection to target. Spikes here BEFORE UnhealthyHostCount — early warning of container crashes.",
      "title": "Target Connection Errors",
      "type": "stat",
      "targets": [
        {
          "alias": "Connection Errors", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "TargetConnectionErrorCount",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "A", "region": "${region}", "statistic": "Sum"
        }
      ]
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Current RPS",
      "type": "stat",
      "targets": [
        {
          "alias": "Requests", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "RequestCount",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "A", "region": "${region}", "statistic": "Sum"
        }
      ]
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 15 }
            ]
          },
          "unit": "percent", "decimals": 2
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "5xx Error Rate %",
      "type": "stat",
      "targets": [
        {
          "alias": "", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}" },
          "hide": true, "id": "m1", "matchExact": true, "metricEditorMode": 0,
          "metricName": "HTTPCode_ELB_5XX_Count", "metricQueryType": 0,
          "namespace": "AWS/ApplicationELB", "period": "300",
          "refId": "A", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}" },
          "hide": true, "id": "m2", "matchExact": true, "metricEditorMode": 0,
          "metricName": "RequestCount", "metricQueryType": 0,
          "namespace": "AWS/ApplicationELB", "period": "300",
          "refId": "B", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "5xx Rate %", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": {}, "expression": "IF(FILL(m2,0)>0,FILL(m1,0)/FILL(m2,0)*100,0)",
          "hide": false, "id": "e1", "matchExact": true, "metricEditorMode": 1,
          "metricName": "", "metricQueryType": 1, "namespace": "",
          "period": "300", "refId": "C", "region": "${region}", "statistic": "Sum"
        }
      ]
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "s", "decimals": 3
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Avg Response Time",
      "type": "stat",
      "targets": [
        {
          "alias": "Avg Latency", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "TargetResponseTime",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "A", "region": "${region}", "statistic": "Average"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📊 Traffic",
      "type": "row"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Requests / min", "drawStyle": "line",
            "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2,
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull", "max", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "title": "Request Count (per minute)",
      "type": "timeseries",
      "targets": [
        {
          "alias": "Total Requests", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "RequestCount",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "A", "region": "${region}", "statistic": "Sum"
        }
      ]
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Requests", "drawStyle": "bars",
            "fillOpacity": 80, "lineWidth": 1,
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx — Success" }, "properties": [{ "id": "color", "value": { "fixedColor": "#37872D", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "3xx — Redirect" }, "properties": [{ "id": "color", "value": { "fixedColor": "#1F60C4", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx — Client Error" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FA6400", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "5xx — Server Error" }, "properties": [{ "id": "color", "value": { "fixedColor": "#C4162A", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "HTTP Status Code Breakdown (Target)",
      "type": "timeseries",
      "targets": [
        {
          "alias": "2xx — Success", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "HTTPCode_Target_2XX_Count",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "A", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "3xx — Redirect", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "HTTPCode_Target_3XX_Count",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "B", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "4xx — Client Error", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "HTTPCode_Target_4XX_Count",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "C", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "5xx — Server Error", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "HTTPCode_Target_5XX_Count",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "D", "region": "${region}", "statistic": "Sum"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "title": "🚨 Errors — Where is the 5xx coming from?",
      "type": "row"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Count / min", "drawStyle": "line",
            "fillOpacity": 15, "lineInterpolation": "smooth", "lineWidth": 2,
            "showPoints": "never", "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short", "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ELB 5xx (502/503/504)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Target 5xx (App Error)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#C4162A", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "description": "Orange = ELB returning 5xx (502=can't reach target, 503=no healthy targets, 504=target timed out). Red = Target app returning 5xx. Orange spike = infra problem. Red spike = app problem.",
      "title": "ELB 5xx vs Target 5xx — Where is the error?",
      "type": "timeseries",
      "targets": [
        {
          "alias": "ELB 5xx (502/503/504)", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "HTTPCode_ELB_5XX_Count",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "A", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "Target 5xx (App Error)", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "HTTPCode_Target_5XX_Count",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "B", "region": "${region}", "statistic": "Sum"
        }
      ]
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Error %", "drawStyle": "line",
            "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2,
            "showPoints": "never", "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 15 }
            ]
          },
          "unit": "percent", "decimals": 2, "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "title": "4xx Error Rate % — Target (yellow >10%, red >15%)",
      "type": "timeseries",
      "targets": [
        {
          "alias": "", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "hide": true, "id": "m1", "matchExact": true, "metricEditorMode": 0,
          "metricName": "HTTPCode_Target_4XX_Count", "metricQueryType": 0,
          "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "A", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}" },
          "hide": true, "id": "m2", "matchExact": true, "metricEditorMode": 0,
          "metricName": "RequestCount", "metricQueryType": 0,
          "namespace": "AWS/ApplicationELB", "period": "60",
          "refId": "B", "region": "${region}", "statistic": "Sum"
        },
        {
          "alias": "4xx Error Rate %", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": {}, "expression": "IF(FILL(m2,0)>0,FILL(m1,0)/FILL(m2,0)*100,0)",
          "hide": false, "id": "e1", "matchExact": true, "metricEditorMode": 1,
          "metricName": "", "metricQueryType": 1, "namespace": "",
          "period": "60", "refId": "C", "region": "${region}", "statistic": "Sum"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 103,
      "title": "⏱ Latency",
      "type": "row"
    },

    {
      "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Response Time", "drawStyle": "line",
            "fillOpacity": 10, "lineInterpolation": "smooth", "lineWidth": 2,
            "showPoints": "never", "spanNulls": false,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "s", "decimals": 3, "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "title": "Avg Target Response Time — yellow >1s, red >3s",
      "type": "timeseries",
      "targets": [
        {
          "alias": "Avg Response Time", "datasource": { "type": "cloudwatch", "uid": "${datasource}" },
          "dimensions": { "LoadBalancer": "${load_balancer_name}", "TargetGroup": "${target_group}" },
          "matchExact": true, "metricEditorMode": 0, "metricName": "TargetResponseTime",
          "metricQueryType": 0, "namespace": "AWS/ApplicationELB",
          "period": "60", "refId": "A", "region": "${region}", "statistic": "Average"
        }
      ]
    },

    {
